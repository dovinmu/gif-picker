# Honeycomb only ever POSTs queries to one table. Proxy exactly that call to
# Antfly Cloud and add the API key here, so the browser never sees it and no
# other Antfly endpoint is reachable from the public site.
# Needs ANTFLY_CLOUD_INSTANCE and ANTFLY_API_KEY in Caddy's environment
# (see README.md, "Configure Caddy").
(antfly_query) {
    @honeycomb_query {
        method POST
        path /db/v1/tables/honeycomb/query
    }
    handle @honeycomb_query {
        rewrite * /cloud/v1/{env.ANTFLY_CLOUD_INSTANCE}/db/v1/tables/honeycomb/query
        reverse_proxy https://platform.antfly.io {
            header_up Host platform.antfly.io
            header_up Authorization "Bearer {env.ANTFLY_API_KEY}"
            header_up -Cookie
        }
    }
    handle /db/v1/* {
        respond 404
    }
}

:80 {
    import antfly_query

    handle {
        root * /var/www/honeycomb
        try_files {path} /index.html
        file_server
    }

    encode gzip
}

honeycomb.rowan.earth, honeycomb.antfly.io {
    import antfly_query

    handle {
        root * /var/www/honeycomb
        try_files {path} /index.html
        file_server
    }

    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

admin.honeycomb.rowan.earth {
    @notAcme not path /.well-known/acme-challenge/*
    basic_auth @notAcme {
        # caddy hash-password --plaintext <password>
        adminaf $2a$14$REPLACE_WITH_HASH
    }

    reverse_proxy localhost:8080

    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

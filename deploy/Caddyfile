:80 {
    reverse_proxy localhost:8090

    encode gzip
}

honeycomb.rowan.earth, honeycomb.antfly.io {
    reverse_proxy localhost:8090

    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

